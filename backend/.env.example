# NEVER commit real secrets. Copy to .env
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=anon-key-here
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here-KEEP-SERVER-ONLY
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ventapos
JWT_SECRET=change-me
ENV=development
API_V1_PREFIX=/api/v1
# SaaS operators (comma-separated login emails). Empty = none.
PLATFORM_ADMIN_EMAILS=
# Billing webhooks: provider name + signing secret ("manual" = admin-assigned).
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=
